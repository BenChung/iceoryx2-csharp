<Project Sdk="Microsoft.NET.Sdk">

  <!-- Machine-local game deployment settings (gitignored); see DeployToGame below -->
  <Import Project="$(MSBuildThisFileDirectory)../../GameDeploy.props"
          Condition="Exists('$(MSBuildThisFileDirectory)../../GameDeploy.props')" />

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    
    <!-- Package Information -->
    <PackageId>Iceoryx2</PackageId>
    <Version>0.1.0</Version>
    <Authors>Contributors to the Eclipse Foundation</Authors>
    <Company>Eclipse iceoryx</Company>
    <Description>Zero-Copy Lock-Free Inter-process Communication for .NET</Description>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/eclipse-iceoryx/iceoryx2</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eclipse-iceoryx/iceoryx2</RepositoryUrl>
    <PackageTags>ipc;inter-process-communication;zero-copy;shared-memory;publish-subscribe;request-response</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>See CHANGELOG.md for release notes</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**" />
  </ItemGroup>

  <!-- Include README and icon in package -->
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Package native libraries for different platforms -->
  <ItemGroup>
    <!-- macOS (osx-x64 and osx-arm64) -->
    <None Include="../../iceoryx2/target/release/libiceoryx2_ffi_c.dylib" 
          Pack="true" 
          PackagePath="runtimes/osx-x64/native/libiceoryx2_ffi_c.dylib"
          Condition="Exists('../../iceoryx2/target/release/libiceoryx2_ffi_c.dylib')" />
    <None Include="../../iceoryx2/target/release/libiceoryx2_ffi_c.dylib" 
          Pack="true" 
          PackagePath="runtimes/osx-arm64/native/libiceoryx2_ffi_c.dylib"
          Condition="Exists('../../iceoryx2/target/release/libiceoryx2_ffi_c.dylib')" />
    
    <!-- Linux x64 -->
    <None Include="../../iceoryx2/target/release/libiceoryx2_ffi_c.so" 
          Pack="true" 
          PackagePath="runtimes/linux-x64/native/libiceoryx2_ffi_c.so"
          Condition="Exists('../../iceoryx2/target/release/libiceoryx2_ffi_c.so')" />
    
    <!-- Windows x64 -->
    <None Include="../../iceoryx2/target/release/iceoryx2_ffi_c.dll" 
          Pack="true" 
          PackagePath="runtimes/win-x64/native/iceoryx2_ffi_c.dll"
          Condition="Exists('../../iceoryx2/target/release/iceoryx2_ffi_c.dll')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="PolySharp" Version="1.16.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Copy native library to output directory of any project referencing this library -->
  <Target Name="CopyNativeLibrary" AfterTargets="Build">
    <PropertyGroup>
      <!-- Path relative to this .csproj file location (src/Iceoryx2/) -->
      <NativeLibrarySourcePath>$(MSBuildThisFileDirectory)../../iceoryx2/target/release/libiceoryx2_ffi_c.dylib</NativeLibrarySourcePath>
      <NativeLibrarySourcePathLinux>$(MSBuildThisFileDirectory)../../iceoryx2/target/release/libiceoryx2_ffi_c.so</NativeLibrarySourcePathLinux>
      <NativeLibrarySourcePathWindows>$(MSBuildThisFileDirectory)../../iceoryx2/target/release/iceoryx2_ffi_c.dll</NativeLibrarySourcePathWindows>
    </PropertyGroup>
    
    <!-- macOS -->
    <Copy SourceFiles="$(NativeLibrarySourcePath)" 
          DestinationFolder="$(OutputPath)" 
          Condition="Exists('$(NativeLibrarySourcePath)')"
          SkipUnchangedFiles="true" />
    
    <!-- Linux -->
    <Copy SourceFiles="$(NativeLibrarySourcePathLinux)" 
          DestinationFolder="$(OutputPath)" 
          Condition="Exists('$(NativeLibrarySourcePathLinux)')"
          SkipUnchangedFiles="true" />
    
    <!-- Windows -->
    <Copy SourceFiles="$(NativeLibrarySourcePathWindows)"
          DestinationFolder="$(OutputPath)"
          Condition="Exists('$(NativeLibrarySourcePathWindows)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Deploys the managed and native DLLs into the game checkout named by
       GameDir in GameDeploy.props at the repository root. Runs on the
       netstandard2.1 Release build (the Unity-facing target) and is a no-op
       when GameDeploy.props is absent. A DLL held open by a running Unity
       editor downgrades that copy to a warning. -->
  <Target Name="DeployToGame" AfterTargets="Build"
          Condition="'$(GameDir)' != '' And '$(TargetFramework)' == 'netstandard2.1' And '$(Configuration)' == 'Release'">
    <PropertyGroup>
      <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(GameDir)\Assets\Scripts\AI\Scripten\ServerLibs</GameManagedDir>
      <GameNativeDir Condition="'$(GameNativeDir)' == ''">$(GameDir)\Assets\Plugins\Windows\x86_64</GameNativeDir>
      <GameNativeDllPath>$(MSBuildThisFileDirectory)../../iceoryx2/target/release/iceoryx2_ffi_c.dll</GameNativeDllPath>
    </PropertyGroup>

    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GameManagedDir)"
          SkipUnchangedFiles="true"
          ContinueOnError="WarnAndContinue" />
    <Copy SourceFiles="$(GameNativeDllPath)"
          DestinationFolder="$(GameNativeDir)"
          Condition="Exists('$(GameNativeDllPath)')"
          SkipUnchangedFiles="true"
          ContinueOnError="WarnAndContinue" />
    <Message Importance="high" Text="Deployed Iceoryx2.dll and iceoryx2_ffi_c.dll to $(GameDir)" />
  </Target>

</Project>
